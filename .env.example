# Node does not load this file automatically. Use: node --env-file=.env dist/index.js
SUPERZOO_COUNTRY=SK
SUPERZOO_TRANSPORT=stdio

# HTTP only. Change transport to http to enable.
SUPERZOO_HOST=127.0.0.1
SUPERZOO_PORT=3000
# Optional comma-separated hostnames/IPs, without scheme or port.
# SUPERZOO_ALLOWED_HOSTS=localhost,127.0.0.1,::1,mcp.example.com
# Optional exact browser origins. Requests containing Origin are rejected unless explicitly allowed.
# SUPERZOO_ALLOWED_ORIGINS=https://client.example.com
