{
  "name": "superzoo-mcp",
  "version": "0.2.0",
  "description": "Read-only Super zoo product search, prices, and store availability for Slovakia, Czechia, and Poland",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "presmoke": "npm run build",
    "smoke": "node scripts/smoke.js",
    "prepack": "npm run build",
    "pretest:package": "npm run build",
    "test:package": "node --test test/package-smoke.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benjaminstary/superzoo-mcp.git"
  },
  "bin": {
    "superzoo-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "superzoo",
    "model-context-protocol",
    "prices",
    "stock",
    "pet-supplies"
  ],
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
